# ==============================================================================
# Ajhar Digital Twin & AI Automation Business Assistant — Environment Template
# ==============================================================================
# Copy this file to `.env` and replace the placeholder values with your real API keys.
# Never commit your real `.env` file to version control.
#
# Quick start (PowerShell):
#   Copy-Item .env.example .env
# ==============================================================================

# Required: Google Gemini API Key (used with the OpenAI-compatible Gemini endpoint)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY="your_google_gemini_api_key_here"

# Optional fallback alias (the notebook checks GOOGLE_API_KEY first, then GEMINI_API_KEY)
# GEMINI_API_KEY="your_google_gemini_api_key_here"
