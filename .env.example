# ==============================================================================
# Ajhar Digital Twin & AI Automation Business Assistant — Environment Template
# ==============================================================================
# Copy this file to `.env` and replace the placeholder values with your real API keys.
# Never commit your real `.env` file to version control.
#
# Quick start (PowerShell):
#   Copy-Item .env.example .env
# ==============================================================================

# Required: Google Gemini API Key (used with the OpenAI-compatible Gemini endpoint)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY="your_google_gemini_api_key_here"

# Optional fallback alias (the app checks GOOGLE_API_KEY first, then GEMINI_API_KEY)
# GEMINI_API_KEY="your_google_gemini_api_key_here"

# Optional: Primary Gemini model and comma-separated fallback chain for 503/429 failover
# GEMINI_MODEL="gemini-2.5-flash"
# GEMINI_FALLBACK_MODELS="gemini-2.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite"

# Optional: Pushover Real-Time Mobile Notifications (fail-open if omitted or disabled)
# 1. Sign up at https://pushover.net/ and copy your 30-char User Key (starts with 'u')
# 2. Create an Application API Token (starts with 'a', 30 chars)
PUSHOVER_USER=""
PUSHOVER_TOKEN=""
PUSHOVER_ENABLED=true
